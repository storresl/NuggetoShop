<!-- Store Header -->
<header class="bg-slate-900 -mx-4 sm:-mx-6 lg:-mx-8 -mt-20 pt-20 mb-8 overflow-hidden rounded-b-3xl shadow-lg font-outfit">
  <div class="px-6 py-6 sm:px-12 sm:py-8 flex justify-center items-center gap-4">
    <!-- Logo -->
    <div class="w-20 h-20 rounded-full bg-white/10 overflow-hidden flex items-center justify-center shrink-0">
      <img src={~p"/images/nuggeto.png"} alt="Mascot Logo" class="w-full h-full object-contain" />
    </div>
    <!-- Text Content -->
    <div class="flex flex-col justify-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white drop-shadow-md">
        Don <span class="text-orange-500">Nuggeto</span>
      </h1>
      <p class="text-slate-300 text-lg font-medium mt-1">
        📣 Cantando ofertas de mudanza!
      </p>
    </div>
  </div>
</header>

<!-- Filters & Search -->
<div class="max-w-5xl mx-auto mb-8 flex flex-col md:flex-row gap-4 items-center justify-between">
  <!-- Categories -->
  <div class="flex flex-col gap-2 overflow-x-auto w-full md:w-auto hide-scrollbar pb-2 md:pb-0">
    <div class="flex gap-2 w-max">
      <%= for cat <- ["Todo", "Electrodomésticos", "Deporte", "Juegos de Mesa", "Música"] do %>
        <a
          href={"/?category=#{URI.encode(cat)}&q=#{URI.encode(@search_query)}"}
          class={[
            "px-4 py-2 rounded-full whitespace-nowrap text-sm font-semibold transition-colors border",
            if(@active_category == cat,
              do: "bg-[#F97316] text-white border-[#F97316]",
              else: "bg-white text-gray-700 border-gray-200 hover:bg-gray-50"
            )
          ]}
        >
          {cat}
        </a>
      <% end %>
    </div>
    <div class="flex gap-2 w-max">
      <%= for cat <- ["Muebles", "Camping", "Videojuegos", "Libros"] do %>
        <a
          href={"/?category=#{URI.encode(cat)}&q=#{URI.encode(@search_query)}"}
          class={[
            "px-4 py-2 rounded-full whitespace-nowrap text-sm font-semibold transition-colors border",
            if(@active_category == cat,
              do: "bg-[#F97316] text-white border-[#F97316]",
              else: "bg-white text-gray-700 border-gray-200 hover:bg-gray-50"
            )
          ]}
        >
          {cat}
        </a>
      <% end %>
    </div>
  </div>

  <!-- Search -->
  <form action="/" method="get" class="w-full md:w-64">
    <input type="hidden" name="category" value={@active_category} />
    <input
      type="search"
      name="q"
      value={@search_query}
      placeholder="Buscar productos..."
      class="w-full px-4 py-2 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#F97316] focus:border-transparent text-sm"
    />
  </form>
</div>

<!-- Items Grid -->
<div class="max-w-5xl mx-auto pb-12">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <%= for item <- @items do %>
      <div class={[
        "group rounded-2xl border border-gray-100 bg-white overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col",
        if(Map.get(item, :status, "available") != "available",
          do: "opacity-60 grayscale",
          else: ""
        )
      ]}>
        <!-- Clickable Area -->
        <div
          class="cursor-pointer flex flex-col flex-grow group/card"
          onclick={"document.getElementById('modal-#{item.id}').showModal()"}
        >
          <!-- Image Carousel -->
          <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar aspect-[4/3] border-b border-gray-100 relative">
            <div class="absolute inset-0 bg-black/0 group-hover/card:bg-black/5 transition-colors z-10 pointer-events-none">
            </div>
            <%= for image <- Map.get(item, :images, []) do %>
              <div class="shrink-0 w-full h-full snap-center relative bg-gray-50">
                <img
                  src={image}
                  alt={item.name}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            <% end %>
          </div>

          <!-- Card Content -->
          <div class="p-5 flex flex-col flex-grow pb-2">
            <div class="flex justify-between items-start mb-2">
              <h2 class="text-lg font-bold text-gray-900 leading-tight group-hover/card:text-[#F97316] transition-colors">
                {item.name}
              </h2>
              <div class="flex items-center gap-2 flex-wrap justify-end">
                <%= case Map.get(item, :status, "available") do %>
                  <% "reserved" -> %>
                    <span class="inline-block bg-orange-100 text-orange-800 font-bold px-2 py-1 rounded text-sm whitespace-nowrap">Reservado</span>
                  <% "sold" -> %>
                    <span class="inline-block bg-gray-200 text-gray-800 font-bold px-2 py-1 rounded text-sm whitespace-nowrap">Vendido</span>
                  <% _ -> %>
                <% end %>
                <span class="inline-block bg-[#F97316]/10 text-[#F97316] font-bold px-2 py-1 rounded text-sm whitespace-nowrap">
                  {item.price}
                </span>
              </div>
            </div>

            <p class="text-gray-600 text-sm flex-grow line-clamp-3">
              {item.description}
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="p-5 pt-4">
          <%= case Map.get(item, :status, "available") do %>
            <% "available" -> %>
              <div class="flex flex-col gap-3">
                <button
                  type="button"
                  onclick={"document.getElementById('modal-#{item.id}').showModal()"}
                  class="w-full text-center bg-gray-900 hover:bg-gray-800 text-white font-semibold py-2.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2"
                >
                  <.icon name="hero-eye" class="w-5 h-5" /> Ver más
                </button>
              </div>
            <% "reserved" -> %>
              <div class="block w-full text-center bg-orange-100 text-orange-800 font-semibold py-2.5 rounded-xl cursor-not-allowed">
                Reservado
              </div>
            <% "sold" -> %>
              <div class="block w-full text-center bg-gray-100 text-gray-500 font-semibold py-2.5 rounded-xl cursor-not-allowed">
                Vendido
              </div>
          <% end %>
        </div>

        <!-- PDP Modal -->
        <dialog id={"modal-#{item.id}"} class="modal">
          <div class="modal-box w-11/12 max-w-4xl p-0 overflow-hidden bg-white shadow-2xl rounded-2xl flex flex-col md:flex-row max-h-[90vh]">
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 z-20 bg-white/80 hover:bg-white text-gray-800 shadow-sm border border-gray-200">✕</button>
            </form>

            <!-- Modal Image Carousel -->
            <div class="w-full md:w-1/2 bg-gray-100 shrink-0">
              <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar aspect-square md:aspect-auto md:h-full">
                <%= for image <- Map.get(item, :images, []) do %>
                  <div class="shrink-0 w-full h-full snap-center relative">
                    <img
                      src={image}
                      alt={item.name}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Modal Details -->
            <div class="w-full md:w-1/2 p-6 md:p-8 flex flex-col overflow-y-auto md:max-h-[90vh]">
              <div class="flex justify-between items-start mb-6 shrink-0 mt-2">
                <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 leading-tight pr-8">
                  {item.name}
                </h2>
                <div class="flex items-center flex-col md:flex-row gap-2 shrink-0">
                  <%= case Map.get(item, :status, "available") do %>
                    <% "reserved" -> %>
                      <span class="inline-block bg-orange-100 text-orange-800 shadow-sm font-bold px-4 py-2 rounded-xl text-xl whitespace-nowrap">Reservado</span>
                    <% "sold" -> %>
                      <span class="inline-block bg-gray-200 text-gray-800 shadow-sm font-bold px-4 py-2 rounded-xl text-xl whitespace-nowrap">Vendido</span>
                    <% _ -> %>
                  <% end %>
                  <span class="inline-block bg-[#FCD34D] text-gray-900 shadow-sm font-bold px-4 py-2 rounded-xl text-xl whitespace-nowrap">
                    {item.price}
                  </span>
                </div>
              </div>

              <div class="mb-6 pr-2">
                <p class="text-gray-700 whitespace-pre-line leading-relaxed text-base md:text-lg">
                  {item.description}
                </p>
              </div>

              <div class="mt-auto pt-6 border-t border-gray-100 shrink-0">
                <%= case Map.get(item, :status, "available") do %>
                  <% "available" -> %>
                    <% price_int = String.replace(item.price, ~r/\D/, "") %>
                    <div class="flex flex-col gap-4">
                      <div class="flex flex-col items-center">
                        <form action={"/reserve/#{item.id}"} method="post" class="w-full">
                          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                          <button
                            type="submit"
                            class="w-full text-center bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-3.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2 text-lg"
                          >
                            <.icon name="hero-chat-bubble-oval-left-ellipsis" class="w-6 h-6" />
                            Contactar por WhatsApp
                          </button>
                        </form>
                        <p class="text-sm text-gray-500 mt-2 text-center font-medium">Al contactar por WhatsApp reservas el producto por 2h</p>
                      </div>
                      
                      <div class="flex flex-col items-center pt-2">
                        <a
                          href={"https://fintoc.me/sebatorres/#{price_int}"}
                          target="_blank"
                          class="block w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2 text-lg"
                        >
                          <.icon name="hero-banknotes" class="w-6 h-6" /> Pagar con transferencia
                        </a>
                        <p class="text-sm text-gray-500 mt-2 text-center font-medium">Puedes pagar de inmediato, ¡recuerda avisarme por WhatsApp!</p>
                      </div>
                    </div>
                  <% "reserved" -> %>
                    <div class="block w-full text-center bg-orange-100 text-orange-800 font-bold py-3.5 rounded-xl cursor-not-allowed text-lg">
                      Reservado
                    </div>
                  <% "sold" -> %>
                    <div class="block w-full text-center bg-gray-100 text-gray-500 font-bold py-3.5 rounded-xl cursor-not-allowed text-lg">
                      Vendido
                    </div>
                <% end %>
              </div>
            </div>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>cerrar</button>
          </form>
        </dialog>
      </div>
    <% end %>
  </div>
</div>
