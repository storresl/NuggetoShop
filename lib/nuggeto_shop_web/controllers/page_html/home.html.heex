<!-- Store Header -->
<header class="bg-slate-900 mb-8 overflow-hidden rounded-b-3xl shadow-lg font-outfit w-full">
  <div class="px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full py-6 sm:py-8 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <!-- Logo -->
      <div class="w-24 sm:w-32 h-24 sm:h-32 flex items-center justify-center shrink-0">
        <img src={~p"/images/nuggeto.png"} alt="Mascot Logo" class="w-full h-full object-contain drop-shadow-md" />
      </div>
      <!-- Text Content -->
      <div class="flex flex-col justify-center text-left">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white drop-shadow-md leading-tight">
          Don<br />
          <span class="text-orange-500">Nuggeto</span>
        </h1>
      </div>
    </div>
    
    <!-- Legend -->
    <div class="text-right max-w-[200px] sm:max-w-none">
      <span class="text-slate-300 text-base sm:text-xl font-medium leading-snug block">
        ✈️ Vendiendo todo por viaje!
      </span>
    </div>
  </div>
</header>

<!-- Main Content Container with Padding -->
<main class="px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
  <!-- Filters & Search -->
  <div class="mb-8 flex flex-col md:flex-row gap-4 items-center justify-between w-full">
  <!-- Categories -->
  <div class="flex gap-2 overflow-x-auto w-full md:w-auto hide-scrollbar pb-2 md:pb-0 items-center">
    <div class="flex gap-2 w-max">
      <%= for cat <- ["Todo" | @categories] do %>
        <a
          href={"/?category=#{URI.encode(cat)}&q=#{URI.encode(@search_query)}&hide_unavailable=#{@hide_unavailable}"}
          class={[
            "px-4 py-2 rounded-full whitespace-nowrap text-sm font-semibold transition-colors border",
            if(@active_category == cat,
              do: "bg-[#F97316] text-white border-[#F97316]",
              else: "bg-white text-gray-700 border-gray-200 hover:bg-gray-50"
            )
          ]}
        >
          {cat}
        </a>
      <% end %>
    </div>
  </div>

  <!-- Search and Toggles -->
  <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0 items-center">
    <a
      href={"/?category=#{URI.encode(@active_category)}&q=#{URI.encode(@search_query)}&hide_unavailable=#{not @hide_unavailable}"}
      class={[
        "px-4 py-2 rounded-full border text-sm font-semibold transition-colors flex items-center gap-2 w-full sm:w-auto justify-center",
        if(@hide_unavailable,
          do: "bg-gray-900 text-white border-gray-900",
          else: "bg-white text-gray-700 border-gray-200 hover:bg-gray-50"
        )
      ]}
    >
      <.icon name={if @hide_unavailable, do: "hero-eye-slash", else: "hero-eye"} class="w-4 h-4" />
      Ocultar no disponibles
    </a>

    <form action="/" method="get" class="w-full sm:w-64 shrink-0">
      <input type="hidden" name="category" value={@active_category} />
      <input type="hidden" name="hide_unavailable" value={to_string(@hide_unavailable)} />
      <input
        type="search"
        name="q"
        value={@search_query}
        placeholder="Buscar productos..."
        class="w-full px-4 py-2 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#F97316] focus:border-transparent text-sm"
      />
    </form>
  </div>
</div>

  <!-- Items Grid -->
  <div class="pb-12 w-full">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6 w-full">
    <%= for item <- @items do %>
      <%= if not @hide_unavailable or Map.get(item, :status, "available") == "available" do %>
      <div class={[
        "group rounded-2xl border border-gray-100 bg-white overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col",
        if(Map.get(item, :status, "available") != "available",
          do: "opacity-60 grayscale",
          else: ""
        )
      ]}>
        <!-- Clickable Area -->
        <div
          class="cursor-pointer flex flex-col flex-grow group/card"
          onclick={"document.getElementById('modal-#{item.id}').showModal()"}
        >
          <!-- Image Carousel -->
          <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar aspect-[4/3] border-b border-gray-100 relative">
            <div class="absolute inset-0 bg-black/0 group-hover/card:bg-black/5 transition-colors z-10 pointer-events-none">
            </div>
            <%= for image <- [Map.get(item, :image)] do %>
              <div class="shrink-0 w-full h-full snap-center relative bg-gray-50">
                <img
                  src={image}
                  alt={item.name}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            <% end %>
          </div>

          <!-- Card Content -->
          <div class="p-4 sm:p-5 flex flex-col flex-grow pb-2">
            <div class="flex flex-col gap-1 mb-2">
              <h2 class="text-base sm:text-lg font-bold text-gray-900 leading-tight group-hover/card:text-[#F97316] transition-colors line-clamp-2">
                {item.name}
              </h2>
              
              <div class="flex items-center gap-2 flex-wrap mt-1">
                <div class="flex flex-col">
                  <%= if Map.get(item, :reference_price) do %>
                    <span class="text-gray-400 line-through text-[11px] sm:text-xs leading-none font-medium">
                      {item.reference_price}
                    </span>
                  <% end %>
                  <span class="inline-block bg-[#F97316]/10 text-[#F97316] font-bold px-2 py-1 rounded text-sm sm:text-base whitespace-nowrap mt-0.5 w-max">
                    {item.price}
                  </span>
                </div>
                <%= case Map.get(item, :status, "available") do %>
                  <% "reserved" -> %>
                    <span class="inline-block bg-orange-100 text-orange-800 font-bold px-2 py-1 rounded text-xs whitespace-nowrap mt-auto mb-0.5 ml-auto">Reservado</span>
                  <% "sold" -> %>
                    <span class="inline-block bg-gray-200 text-gray-800 font-bold px-2 py-1 rounded text-xs whitespace-nowrap mt-auto mb-0.5 ml-auto">Vendido</span>
                  <% _ -> %>
                <% end %>
              </div>
            </div>

            <p class="hidden md:block text-gray-500 text-sm flex-grow line-clamp-2 mt-2">
              {item.description}
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="p-5 pt-4">
          <%= case Map.get(item, :status, "available") do %>
            <% "available" -> %>
              <div class="flex flex-col gap-3">
                <button
                  type="button"
                  onclick={"document.getElementById('modal-#{item.id}').showModal()"}
                  class="w-full text-center bg-gray-900 hover:bg-gray-800 text-white font-semibold py-2.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2"
                >
                  <.icon name="hero-eye" class="w-5 h-5" /> Ver más
                </button>
              </div>
            <% "reserved" -> %>
              <div class="block w-full text-center bg-orange-100 text-orange-800 font-semibold py-2.5 rounded-xl cursor-not-allowed">
                Reservado
              </div>
            <% "sold" -> %>
              <div class="block w-full text-center bg-gray-100 text-gray-500 font-semibold py-2.5 rounded-xl cursor-not-allowed">
                Vendido
              </div>
          <% end %>
        </div>

        <!-- PDP Modal -->
        <dialog id={"modal-#{item.id}"} class="modal">
          <div class="modal-box w-11/12 max-w-4xl p-0 overflow-hidden bg-white shadow-2xl rounded-2xl flex flex-col md:flex-row max-h-[90vh]">
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 z-20 bg-white/80 hover:bg-white text-gray-800 shadow-sm border border-gray-200">✕</button>
            </form>

            <!-- Modal Image Carousel -->
            <div class="w-full md:w-1/2 bg-gray-100 shrink-0">
              <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar h-56 sm:h-64 md:h-full md:min-h-[400px]">
                <%= for image <- [Map.get(item, :image)] do %>
                  <div class="shrink-0 w-full h-full snap-center relative">
                    <img
                      src={image}
                      alt={item.name}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Modal Details -->
            <div class="w-full md:w-1/2 p-6 md:p-8 flex flex-col overflow-y-auto md:max-h-[90vh]">
              <div class="flex justify-between items-start mb-6 shrink-0 mt-2 gap-4">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-gray-900 leading-tight">
                  {item.name}
                </h2>
                <div class="flex items-end md:items-center flex-col md:flex-row gap-2 shrink-0">
                  <%= case Map.get(item, :status, "available") do %>
                    <% "reserved" -> %>
                      <span class="inline-block bg-orange-100 text-orange-800 shadow-sm font-bold px-2 md:px-4 py-1 md:py-2 rounded-lg md:rounded-xl text-sm md:text-xl whitespace-nowrap">Reservado</span>
                    <% "sold" -> %>
                      <span class="inline-block bg-gray-200 text-gray-800 shadow-sm font-bold px-2 md:px-4 py-1 md:py-2 rounded-lg md:rounded-xl text-sm md:text-xl whitespace-nowrap">Vendido</span>
                    <% _ -> %>
                  <% end %>
                  <div class="flex flex-col items-end md:flex-row md:items-center gap-1 md:gap-3">
                    <%= if Map.get(item, :reference_price) do %>
                      <span class="text-gray-400 line-through text-xs md:text-lg font-medium leading-none">
                        {item.reference_price}
                      </span>
                    <% end %>
                    <span class="inline-block bg-[#FCD34D] text-gray-900 shadow-sm font-bold px-3 md:px-4 py-1.5 md:py-2 rounded-lg md:rounded-xl text-base md:text-xl whitespace-nowrap">
                      {item.price}
                    </span>
                  </div>
                </div>
              </div>

              <div class="mb-6 pr-2">
                <p class="text-gray-700 whitespace-pre-line leading-relaxed text-base md:text-lg">
                  {item.description}
                </p>
              </div>

              <div class="mt-auto pt-6 border-t border-gray-100 shrink-0">
                <%= case Map.get(item, :status, "available") do %>
                  <% "available" -> %>
                    <% price_int = String.replace(item.price, ~r/\D/, "") %>
                    <div class="flex flex-col gap-4">
                      <div class="flex flex-col items-center">
                        <form action={"/reserve/#{item.id}"} method="post" class="w-full">
                          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                          <button
                            type="submit"
                            class="w-full text-center bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-3.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2 text-lg"
                          >
                            <.icon name="hero-chat-bubble-oval-left-ellipsis" class="w-6 h-6" />
                            Contactar por WhatsApp
                          </button>
                        </form>
                        <p class="text-sm text-gray-500 mt-2 text-center font-medium">Al contactar por WhatsApp reservas el producto por 2h</p>
                      </div>
                      
                      <div class="flex flex-col items-center pt-2">
                        <a
                          href={"https://fintoc.me/sebatorres/#{price_int}"}
                          target="_blank"
                          class="block w-full text-center bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2 text-lg"
                        >
                          <.icon name="hero-banknotes" class="w-6 h-6" /> Pagar con transferencia
                        </a>
                        <p class="text-sm text-gray-500 mt-2 text-center font-medium">Puedes pagar de inmediato, ¡recuerda avisarme por WhatsApp!</p>
                      </div>
                    </div>
                  <% "reserved" -> %>
                    <div class="block w-full text-center bg-orange-100 text-orange-800 font-bold py-3.5 rounded-xl cursor-not-allowed text-lg">
                      Reservado
                    </div>
                  <% "sold" -> %>
                    <div class="block w-full text-center bg-gray-100 text-gray-500 font-bold py-3.5 rounded-xl cursor-not-allowed text-lg">
                      Vendido
                    </div>
                <% end %>
              </div>
            </div>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>cerrar</button>
          </form>
        </dialog>
      </div>
      <% end %>
    <% end %>
  </div>
</div>
</main>
